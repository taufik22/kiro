# =========================================
# ChatGPT Plus Payment Gateway - Configuration
# =========================================

# Set ke "false" untuk SANDBOX (testing)
# Set ke "true" untuk PRODUCTION (live)
MIDTRANS_IS_PRODUCTION=false

# Dapatkan keys dari:
# Sandbox    -> https://dashboard.sandbox.midtrans.com/settings/config_info
# Production -> https://dashboard.midtrans.com/settings/config_info
MIDTRANS_SERVER_KEY=SB-Mid-server-XXXXXXXXXXXXXXXXXXXXXXXX
MIDTRANS_CLIENT_KEY=SB-Mid-client-XXXXXXXXXXXXXXXXXXXX

# =========================================
# Server Configuration
# =========================================
PORT=3000

# Base URL (untuk redirect setelah bayar)
# Local dev  : http://localhost:3000
# Production : https://domain-kamu.com (HARUS HTTPS untuk production!)
BASE_URL=http://localhost:3000
